PORT=3000

DATABASE_URL=postgres://medchain:<YOUR_DATABASE_PASSWORD>@localhost:5432/medchain

JWT_SECRET=<YOUR_EXISTING_RANDOM_JWT_SECRET>
BOOTSTRAP_SECRET=<YOUR_EXISTING_BOOTSTRAP_SECRET>
IDENTITY_COMMITMENT_KEY=<YOUR_EXISTING_IDENTITY_COMMITMENT_KEY>
PII_ENCRYPTION_KEY=<YOUR_64_HEX_CHARACTER_ENCRYPTION_KEY>

# false runs the API without a chain. Registration returns 503, and the four
# blockchain variables below are not required. true, or omitting the flag, requires them.
BLOCKCHAIN_ENABLED=true

RPC_URL=https://11155111.rpc.thirdweb.com/YOUR_CLIENT_ID
PATIENT_REGISTRY_ADDRESS=<YOUR_LATEST_SEPOLIA_PATIENT_REGISTRY_ADDRESS>
BLOCKCHAIN_PRIVATE_KEY=<YOUR_AUTHORIZED_SEPOLIA_HOSPITAL_ADMIN_PRIVATE_KEY>
# Patient controllers are supplied per registration. Do not set one shared controller.
THIRDWEB_SECRET_KEY=your_saved_secret_key
CORS_ORIGIN=http://localhost:5173