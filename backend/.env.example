PORT=3000

DATABASE_URL=postgres://medchain:<YOUR_DATABASE_PASSWORD>@localhost:5432/medchain

JWT_SECRET=<YOUR_EXISTING_RANDOM_JWT_SECRET>
BOOTSTRAP_SECRET=<YOUR_EXISTING_BOOTSTRAP_SECRET>
IDENTITY_COMMITMENT_KEY=<YOUR_EXISTING_IDENTITY_COMMITMENT_KEY>
PII_ENCRYPTION_KEY=<YOUR_64_HEX_CHARACTER_ENCRYPTION_KEY>

# false runs the API without a chain. Registration returns 503, and the four
# blockchain variables below are not required. true, or omitting the flag, requires them.
BLOCKCHAIN_ENABLED=true

# Public Sepolia RPC. Do not put a provider secret in source control.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Current PatientRegistry from blockchain/deployments/sepolia.json. Do not redeploy to fill this in.
PATIENT_REGISTRY_ADDRESS=0xDe1501AF8BACc3c1040788AFb8d2f784Ab8e2806
BLOCKCHAIN_PRIVATE_KEY=<SEPOLIA_HOSPITAL_ADMIN_PRIVATE_KEY>
# Patient controllers are supplied per registration. Do not set one shared controller.
# Optional. Leave empty when the RPC does not require it.
THIRDWEB_SECRET_KEY=
# Browser origin allowed to call the API. Use the deployed frontend origin in production.
CORS_ORIGIN=http://localhost:5173
# true skips rate limits for patient login, wallet challenges, and recovery-code checks.
# Signature, ownership, and recovery validation stay in place. Leave false outside a demo.
DEMO_DISABLE_RATE_LIMIT=false